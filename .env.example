DATABASE_URL=postgresql://user:password@localhost:5432/swarm_leads
# Production: append ?connection_limit=N to control Prisma pool size per process
# DATABASE_URL=postgresql://user:password@host:5432/swarm_leads?connection_limit=10
OPENAI_API_KEY=sk-your-key-here
HEADLESS=true
LOG_LEVEL=info

# SMTP mailbox probing — OFF unless both are set to a domain YOU control.
# The probe announces this identity (HELO + MAIL FROM) to third-party mail servers;
# using someone else's domain impersonates them. Unset => MX-only checks, UNKNOWN results.
# SMTP_HELO_DOMAIN=mail.yourdomain.com
# SMTP_PROBE_FROM=verify@yourdomain.com
